<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="DocumentSkills\*.md" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.3.1.70" />
    <PackageReference Include="Sdcb.PaddleOCR" Version="3.3.1" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.Local" Version="3.3.1" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.LocalV5" Version="3.3.1" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.24" />
    <PackageReference Include="VCRuntime.CefSharp.140" Version="1.0.5" />
    <!-- EF Core for SQL Server -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26301" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0" />
    <!-- FluentValidation for model validation -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <!-- Serilog for structured logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="SlackNet" Version="0.18.0" />
  </ItemGroup>

  <Target Name="CopyVCRuntimeToApplicationRoot" AfterTargets="Build">
    <ItemGroup>
      <VCRuntimeBinaries Include="$(OutDir)x64\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VCRuntimeBinaries)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyVCRuntimeToPublishRoot" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <VCRuntimePublishBinaries Include="$(PublishDir)x64\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VCRuntimePublishBinaries)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
